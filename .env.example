# PostgreSQL
# Any local password; docker compose refuses to start without one
DB_PASSWORD=change-me-local

# Backend
JWT_SECRET=change-me-in-production-use-64-chars
GROQ_API_KEY=gsk_your_groq_api_key
ENVIRONMENT=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
# Machine token for /ops/drift and /ops/retrain; unset = those routes return 503
OPS_TOKEN=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# HIPAA
HIPAA_AUDIT_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
