# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://pc_user:pc_local_dev_2024@localhost:5432/predictive_care
DATABASE_URL_SYNC=postgresql://pc_user:pc_local_dev_2024@localhost:5432/predictive_care

# Auth
JWT_SECRET=change-me-in-production-use-64-chars
# Demo accounts (password = username). Unset = on outside production, off in production.
# DEMO_LOGINS=true
# Real accounts as bcrypt hashes; see README "Demo Logins"
# AUTH_USERS={"dr.kim": {"password_hash": "$2b$12$...", "role": "physician", "name": "Dr. Kim"}}

# Groq (optional, for AI narratives)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# App
ENVIRONMENT=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# HIPAA
HIPAA_AUDIT_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
