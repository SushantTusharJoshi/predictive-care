# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://pc_user:change-me-local@localhost:5432/predictive_care
DATABASE_URL_SYNC=postgresql://pc_user:change-me-local@localhost:5432/predictive_care

# Auth
JWT_SECRET=change-me-in-production-use-64-chars
# Demo accounts (password = username). Unset = on outside production, off in production.
# DEMO_LOGINS=true
# Real accounts as bcrypt hashes; see README "Demo Logins"
# AUTH_USERS={"dr.kim": {"password_hash": "$2b$12$...", "role": "physician", "name": "Dr. Kim"}}

# Narratives: groq (default) or bedrock; the other one is the fallback, then the template
NARRATIVE_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0   # or openai.gpt-oss-120b-1:0
# AWS_REGION=us-east-1
# Bedrock Guardrails on prompt and narrative (both must be set to turn it on)
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=
# Daily caps per worker, and narrative cache lifetime
# BEDROCK_DAILY_CAP=500
# GUARDRAIL_DAILY_CAP=1000
# NARRATIVE_CACHE_TTL_S=86400

# Models: versioned, hash-checked artifacts in MODEL_DIR
# MODEL_DIR=data/models
# MODEL_VERSION=              # pin models-<version>.pkl; empty = current.json
# MODEL_S3_URI=s3://bucket/predictive-care/models   # optional sync, needs AWS credentials

# App
ENVIRONMENT=development
LOG_LEVEL=info
# Comma-separated; only these origins get CORS with credentials
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# HIPAA
HIPAA_AUDIT_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
